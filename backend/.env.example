# Server Port (default: 8080)
PORT=8080

# Authentication Mode: 'local' (bypasses Azure AD, serves mock /auth endpoints) or 'azure'
AUTH_MODE=local

# Database Configuration (PostgreSQL)
# Option 1: Full connection string
# DATABASE_URL=postgres://user:password@localhost:5432/dbname?sslmode=disable

# Option 2: Individual variables
DB_HOST=localhost
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=your_password_here
DB_NAME=student_management
DB_SSLMODE=disable
# Optional SSL Root Certificate path
# DB_SSLROOTCERT=./config/ca.pem

# External Services
GOOGLE_MAPS_API_KEY=your_google_maps_api_key_here
GOOGLE_SHEET_API_KEY=your_google_sheet_api_key_here
GOOGLE_SHEET_ID=1LmvPIp-Ixdvur80OKFQ7Dm31QB1KpjOZDAstUWLkK-o
