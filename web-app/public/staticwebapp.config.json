{
  "navigationFallback": {
    "rewrite": "/index.html",
    "exclude": ["/images/*.{png,jpg,gif}", "/css/*", "/js/*", "/assets/*"]
  },
  "routes": [
    {
      "route": "/auth/login",
      "redirect": "/.auth/login/aad?post_login_redirect_uri=/dashboard",
      "statusCode": 302
    },
    {
      "route": "/auth/logout",
      "redirect": "/.auth/logout?post_logout_redirect_uri=/",
      "statusCode": 302
    }
  ]
}
